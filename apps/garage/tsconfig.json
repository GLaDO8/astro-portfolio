{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowJs": true,
		"allowImportingTsExtensions": true,
		"types": ["vite/client", "node"]
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"server/**/*.ts",
		"api/**/*.ts",
		"dev/**/*",
		"test/**/*.ts",
		"vite.config.ts"
	]
}
