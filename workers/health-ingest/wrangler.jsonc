{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "health-ingest",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-07",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": false
		},
		"traces": {
			"enabled": false
		}
	},
	"secrets": {
		"required": ["HEALTH_INGEST_TOKEN"]
	},
	"r2_buckets": [
		{
			"binding": "HEALTH_RAW",
			"bucket_name": "health-raw-data"
		}
	],
	"d1_databases": [
		{
			"binding": "HEALTH_DB",
			"database_name": "health-processed-data",
			"database_id": "7f570a9a-fab7-4f17-a69a-c7717320802f",
			"migrations_dir": "migrations/health-auto-export"
		}
	]
}
