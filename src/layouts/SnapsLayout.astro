---
import Document from "./Document.astro";

interface Props {
	title: string;
	description: string;
	bodyClass?: string;
	class?: string;
	navBlurBackground?: string;
	showFooter?: boolean;
	seo?: {
		ogType?: "website" | "article";
		ogImage?: string;
		ogImageAlt?: string;
		article?: {
			publishedTime: string;
		};
		noindex?: boolean;
		jsonLd?: Record<string, unknown>;
	};
}

const {
	title,
	description,
	bodyClass,
	class: className,
	navBlurBackground,
	showFooter,
	seo,
} = Astro.props;
const mainClass = ["px-0 min-h-0 overflow-hidden pb-0", className].filter(Boolean).join(" ");
---

<Document
    title={title}
    description={description}
    bodyClass={bodyClass}
    mainClass={mainClass}
    navBlurBackground={navBlurBackground}
    constrainShell={false}
    showFooter={showFooter}
    seo={seo}
>
    <slot />
</Document>
