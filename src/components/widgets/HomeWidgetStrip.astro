---
import type { SongData } from "@/lib/widgetConfig";
import MusicWidget from "./MusicWidget";
import PhotoFrameWidget from "./PhotoFrameWidget";
import SidequestWidget from "./SidequestWidget";
import SnapsWidget from "./SnapsWidget";

interface Props {
    songData: SongData;
}

const { songData } = Astro.props;
---

<section
    data-home-widget-strip
    class="h-70 w-full overflow-visible pt-2 sm:h-72 md:mt-12 md:h-78 md:pt-8"
    aria-label="Personal widgets"
>
    <div
        class="home-widget-strip-scroller -mx-4 -mt-10 overflow-x-auto overflow-y-hidden px-4 pt-16 pb-8 md:mx-0 md:mt-0 md:overflow-visible md:px-0 md:pt-0 md:pb-0"
    >
        <div
            class="flex w-max items-start gap-5 [zoom:0.9] sm:gap-2 sm:[zoom:0.78] md:relative md:left-1/2 md:origin-top md:-translate-x-1/2 md:scale-[0.92] md:gap-14 md:[zoom:1] lg:scale-[1.02] lg:gap-18 xl:scale-[1.08] xl:gap-32"
        >
            <div class="rotate-[9deg]">
                <div data-home-widget class="ml-8 mt-5 shrink-0">
                    <PhotoFrameWidget client:visible />
                </div>
            </div>

            <div class="ml-12 md:ml-0 shrink-0 rotate-[-7deg]">
                <div data-home-widget>
                    <MusicWidget songData={songData} client:visible />
                </div>
            </div>
            <a
                href="/sidequests"
                class="-mt-12 block shrink-0 no-underline ml-4 md:-mt-14 md:-ml-12"
                aria-label="Open sidequests"
            >
                <div data-home-widget>
                    <SidequestWidget client:visible />
                </div>
            </a>
            <a
                href="/snaps"
                class="block shrink-0 no-underline sm:-mt-4 sm:-ml-4 md:-mt-2 md:-ml-14"
                aria-label="Open photo roll"
            >
                <div data-home-widget>
                    <SnapsWidget client:visible />
                </div>
            </a>
        </div>
    </div>
</section>

<style>
    .home-widget-strip-scroller {
        scrollbar-width: none;
    }

    .home-widget-strip-scroller::-webkit-scrollbar {
        display: none;
    }
</style>

<script>
    import { defineSound, ensureReady, type SoundDefinition } from "@web-kits/audio";
    import { animate } from "motion/mini";
    import { spring, stagger } from "motion";

    const widgetHoverSound = {
        source: { type: "sine", frequency: { start: 500, end: 880 } },
        envelope: { attack: 0.001, decay: 0.04, sustain: 0, release: 0.02 },
        gain: 0.12,
    } satisfies SoundDefinition;

    const widgetClickSound = {
        source: { type: "triangle", frequency: { start: 1040, end: 520 } },
        envelope: { attack: 0.001, decay: 0.07, sustain: 0, release: 0.02 },
        gain: 0.18,
    } satisfies SoundDefinition;

    const playWidgetHoverSound = defineSound(widgetHoverSound);
    const playWidgetClickSound = defineSound(widgetClickSound);
    const playSound = (sound: () => unknown) => {
        ensureReady()
            .then(() => sound())
            .catch(() => {
                // Browsers may still block audio until a trusted user gesture.
            });
    };

    const strip = document.querySelector<HTMLElement>("[data-home-widget-strip]");
    const widgets = strip?.querySelectorAll<HTMLElement>("[data-home-widget]") ?? [];

    animate(
        widgets,
        { opacity: [0, 1], transform: ["scale(0.001)", "scale(1)"] },
        {
            delay: stagger(0.09),
            type: spring,
            visualDuration: 0.3,
            bounce: 0.5,
        },
    );

    for (const widget of widgets) {
        widget.addEventListener("pointerenter", () => playSound(playWidgetHoverSound));
    }

    const linkedWidgets =
        strip?.querySelectorAll<HTMLAnchorElement>("a[href]:has([data-home-widget])") ??
        [];

    for (const link of linkedWidgets) {
        link.addEventListener("pointerdown", () => playSound(playWidgetClickSound));
    }
</script>
