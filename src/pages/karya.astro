---
import { Image } from "astro:assets";
import researchCall from "@/assets/reachouts/9D060CEB-22DF-49D9-9E78-23CBD5AAC7BA_1_102_o.jpeg";
import paperWireframes from "@/assets/reachouts/crazy-8-new.png";
import fieldworkPlates from "@/assets/reachouts/F9524E03-36D4-4238-B801-5B493ECC50A5_1_102_o 1.png";
import researchInterface from "@/assets/reachouts/Group 483327.png";
import fieldworkClassroom from "@/assets/reachouts/Group 483328.png";
import PhotoFrameWidget from "@/components/widgets/PhotoFrameWidget";
import Document from "@/layouts/Document.astro";

const pitchLinkClass =
    "underline decoration-2 decoration-dotted underline-offset-4 transition-opacity hover:opacity-75";
const resumeUrl = "/reachouts/shreyas-gupta-resume.pdf";

const fieldworkImages = [
    {
        src: fieldworkClassroom,
        alt: "Fieldwork session with students using laptops in a classroom",
        class: "w-48 md:w-56 lg:w-auto lg:flex-[1_1_0]",
        note: "Playtesting new features\nwith school kids",
        noteClass: "-bottom-6 left-4 w-40 -rotate-2 md:left-6 md:w-48",
    },
    {
        src: fieldworkPlates,
        alt: "Participants sorting research cards around plates on a table",
        class: "w-48 md:w-56 lg:w-auto lg:flex-[1_1_0]",
        note: "Making dogfooding\nactivities fun",
        noteClass: "-top-8 left-1/2 w-44 -translate-x-1/2 rotate-3 md:w-44",
    },
    {
        src: paperWireframes,
        alt: "Paper wireframes sketched across folded sheets on a couch",
        class: "w-48 md:w-56 lg:w-auto lg:flex-[1_1_0]",
        note: "Crazy 8 session\nartifacts",
        noteClass: "-bottom-6 left-1/2 w-40 -translate-x-1/2 rotate-2 md:w-40",
    },
    {
        src: researchCall,
        alt: "Remote research interview with four participants on a video call",
        class: "w-80 md:w-[28rem] lg:w-auto lg:flex-[2_1_0]",
        note: "Sync with the HCI lab\nat Gothenburg University",
        noteClass: "-top-8 left-1/2 w-56 -translate-x-1/2 -rotate-3 md:w-52",
    },
    {
        src: researchInterface,
        alt: "Remote field study with Shreyas and a participant on a video call",
        class: "w-80 md:w-[28rem] lg:w-auto lg:flex-[2_1_0]",
        note: "Interviewing families\nfor my thesis",
        noteClass: "-right-1 -bottom-6 w-44 rotate-1 md:right-6 md:w-48",
    },
];

const quotes = [
    {
        name: "Suyash Agarwal",
        role: "Product Designer, Wayground",
        initials: "SA",
        photo: "/noon/suyash.jpeg",
        quote: "You had this way of cutting through the noise in design reviews. While everyone else would go off on tangents, you'd bring it back to the core by asking simple but sharp questions. It forced everyone to pause and actually think about the decisions we were making.",
        linkedin: "https://www.linkedin.com/in/suyashagarwal01/",
    },
    {
        name: "Darshita Patankar",
        role: "Visual Designer, Wayground",
        initials: "DP",
        photo: "/noon/darshita.jpeg",
        quote: "Your design sense and craft really inspires me, to always ask the deeper questions, the depth of opinion and clarity you bring, looking at design beyond screens.",
        linkedin: "https://www.linkedin.com/in/darshitapatankar/",
    },
    {
        name: "Anonymous feedback",
        role: "Atlan",
        initials: "AN",
        quote: "Shreyas has consistently given his 120% to any product areas or modules he owns AND made contributions to both company and design team culture. He pushes himself and the rest of the team to adopt better design practices, & doesn't shy away from sharing feedback when he feels something isn't working.",
    },
    {
        name: "Vaidehi Dalmia",
        role: "PM at Atlan",
        initials: "VD",
        photo: "/noon/vaidehi.webp",
        quote: "I just wanted to say how inspired I have been by your bias for action and fearlessness to question! Thank you for continously raising the PM-design bar.",
        linkedin: "https://www.linkedin.com/in/vaidehidalmia/",
    },
];

const socialLinks = [
    {
        label: "GitHub",
        href: "https://github.com/GLaDO8",
        path: "M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12Z",
    },
    {
        label: "LinkedIn",
        href: "https://www.linkedin.com/in/shreyas-gupta/",
        path: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.063 2.063 0 0 1-2.064-2.065 2.063 2.063 0 0 1 2.064-2.064 2.064 2.064 0 0 1 0 4.129zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.728v20.543C0 23.226.792 24 1.771 24h20.451C23.2 24 24 23.226 24 22.271V1.728C24 .774 23.2 0 22.225 0z",
    },
    {
        label: "X",
        href: "https://x.com/wutamelonshrey",
        path: "M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z",
    },
];
---

<Document
    title="Karya - Shreyas Gupta"
    description="A short pitch to Karya from Shreyas Gupta."
    bodyClass="bg-beige"
    mainClass="bg-beige px-4 py-12 md:py-20"
    showNavigation={false}
    showFooter={false}
>
    <article class="mx-auto flex w-full max-w-5xl flex-col gap-14">
        <header class="mx-auto flex w-full max-w-5xl flex-col items-start gap-8 md:px-48">
            <div class="ml-1 md:ml-0">
                <PhotoFrameWidget client:visible />
            </div>
            <div class="pt-5">
                <h1
                    class="text-pretty font-sans text-3xl leading-tight font-bold tracking-[-0.02em] text-primary md:text-4xl"
                >
                    Why this role caught my eye
                </h1>
                <p class="mt-4 font-sans text-lg font-medium text-secondary md:text-xl">
                    A short note on how I think, work and design
                </p>
            </div>
        </header>

        <div
            class="mx-auto w-full max-w-5xl text-pretty font-sans text-lg leading-[1.7] font-medium tracking-[-0.02em] text-primary md:px-48 md:text-2xl"
        >
            <p>
                I'm Shreyas, a designer with a background in HCI, fieldwork, data and
                enterprise systems. I tend to be drawn towards product work that demands
                deep understanding of user routines, navigating institutional constraints
                and building across functions.
            </p>

            <p class="mt-12">
                This is why Karya's lead product designer role really struck a chord. I
                put together this page for the team to get an idea of what I do and how I
                work.
            </p>

            <section class="mt-14">
                <h2
                    class="text-2xl leading-tight font-bold tracking-[-0.02em] md:text-3xl"
                >
                    Research and Fieldwork
                </h2>
                <p class="mt-12">
                    That belief started taking shape during my work with the HCI Lab at
                    the University of Gothenburg, where I studied the pervasivness and
                    usage of tech families everyday. By building artifacts to understand
                    screen time and fieldwork, I designed non-intrusive ways to study
                    those patterns without physically disrupting the home.
                </p>

                <p class="mt-12">
                    It changed how I design, made me more attentive to space around the
                    products I built - constraints, social dynamics and routine realities.
                </p>
            </section>
        </div>

        <section
            aria-label="Research and fieldwork images"
            class="relative left-1/2 -my-8 w-screen -translate-x-1/2 overflow-x-auto px-6 pt-20 pb-24 [-ms-overflow-style:none] [scrollbar-width:none] md:pl-44 md:pr-0 lg:px-0 [&::-webkit-scrollbar]:hidden"
        >
            <div
                class="flex w-max items-center gap-6 py-2 pr-12 md:gap-12 md:pr-16 lg:ml-60 lg:w-[calc(100%+16rem)] lg:gap-6"
            >
                {
                    fieldworkImages.map((image) => (
                        <figure
                            class={`${image.class} relative shrink-0 rounded-sm bg-white p-2 shadow-[0_12px_30px_rgba(42,35,29,0.2),0_0_4px_rgba(122,122,122,0.2)] lg:shrink`}
                        >
                            <Image
                                src={image.src}
                                alt={image.alt}
                                loading="eager"
                                decoding="async"
                                class="h-auto w-full object-cover"
                            />
                            {image.note && (
                                <>
                                    <div
                                        aria-hidden="true"
                                        class={`${image.noteClass} pointer-events-none absolute z-10 select-none whitespace-pre bg-yellow-300 px-1 py-2.5 text-center font-sans text-xs leading-tight font-medium text-primary shadow-[0_10px_22px_rgba(42,35,29,0.05)] md:text-sm`}
                                    >
                                        {image.note}
                                    </div>
                                    <figcaption class="sr-only">
                                        {image.note.replaceAll("\n", " ")}
                                    </figcaption>
                                </>
                            )}
                        </figure>
                    ))
                }
            </div>
        </section>

        <div
            class="mx-auto w-full max-w-5xl text-pretty font-sans text-lg leading-[1.7] font-medium tracking-[-0.02em] text-primary md:px-48 md:text-2xl"
        >
            <section>
                <h2
                    class="text-2xl leading-tight font-bold tracking-[-0.02em] md:text-3xl"
                >
                    Working at the edge
                </h2>
                <p class="mt-12">
                    At Wayground I led a team of 3 (2 engineers and 1 designer) to rethink
                    workflows that help teachers digitize years of curated offline
                    material into platform-native artifacts. We worked closely with
                    teachers in the US to encode years of judgement into our AI system:
                    intent, difficulty, exceptions and pedagogical methods.
                </p>
                <p class="mt-12">
                    Our work was based on a simple principle: use AI to reduce ambiguity,
                    not remove agency.
                </p>
            </section>

            <section class="mt-14">
                <h2
                    class="text-2xl leading-tight font-bold tracking-[-0.02em] md:text-3xl"
                >
                    My operating system
                </h2>
                <p class="mt-12">
                    I'm comfortable navigating the ambigious parts of product work, a lot
                    of which is storytelling - helping the team see the vision clearly,
                    asking questions that clarify tradeoffs, and collaborating across
                    design, engineering and product until the direction can hold up in
                    practice.
                </p>
                <p class="mt-12">
                    I believe one can learn anything in due time, and operate as a
                    people-oriented generalist, who happens to be great at systems and
                    design. A few people I've worked with describe my working style better
                    than I can.
                </p>
            </section>
        </div>

        <section
            aria-label="Peer testimonials"
            class="relative left-1/2 w-screen -translate-x-1/2 overflow-x-auto px-6 pb-3 [-ms-overflow-style:none] [scrollbar-width:none] md:pl-44 md:pr-0 lg:px-0 [&::-webkit-scrollbar]:hidden"
        >
            <div
                class="flex w-max items-start gap-6 py-2 md:gap-12 md:pr-16 lg:ml-60 lg:gap-8"
            >
                {
                    quotes.map((person) => (
                        <figure class="relative flex w-[21rem] shrink-0 flex-col justify-between gap-8 rounded-sm border border-black/8 bg-white p-5 shadow-xs md:w-[25rem]">
                            <blockquote class="text-pretty font-sans text-base leading-[1.65] font-medium text-primary md:text-lg">
                                "{person.quote}"
                            </blockquote>

                            <figcaption class="flex items-center gap-3 pr-8">
                                <div class="relative size-10 shrink-0">
                                    <div class="flex size-10 items-center justify-center rounded-full border border-black/8 bg-[#faffff] font-sans text-sm font-bold text-primary">
                                        {person.initials}
                                    </div>
                                    <img
                                        src={person.photo}
                                        alt=""
                                        loading="lazy"
                                        decoding="async"
                                        onerror="this.remove()"
                                        class="absolute inset-0 size-10 rounded-full border border-black/8 object-cover"
                                    />
                                </div>
                                <div class="min-w-0">
                                    <p class="font-sans text-sm font-bold leading-tight text-primary md:text-base">
                                        {person.name}
                                    </p>
                                    <p class="font-sans text-sm leading-snug text-secondary md:text-base">
                                        {person.role}
                                    </p>
                                </div>
                            </figcaption>

                            {person.linkedin && (
                                <a
                                    href={person.linkedin}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    aria-label={`${person.name} on LinkedIn`}
                                    class="absolute right-5 bottom-5 inline-flex size-8 items-center justify-center rounded-full text-primary/70 transition-colors hover:text-primary"
                                >
                                    <svg
                                        viewBox="0 0 24 24"
                                        fill="currentColor"
                                        class="size-4"
                                        aria-hidden="true"
                                    >
                                        <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.61 0 4.28 2.38 4.28 5.47v6.27h-.02ZM5.32 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12Zm1.78 13.02H3.54V9H7.1v11.45ZM22.23 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.72V1.72C24 .77 23.21 0 22.23 0Z" />
                                    </svg>
                                </a>
                            )}
                        </figure>
                    ))
                }
            </div>
        </section>

        <footer
            class="mx-auto flex w-full max-w-5xl flex-col gap-12 text-pretty font-sans text-lg leading-[1.7] font-medium tracking-[-0.02em] text-primary md:px-48 md:text-2xl"
        >
            <p>
                Karya stood out for me because it is refusing this premise that "the
                engine of society is eternal and we must occupy our preordained
                positions", that the design problem is about how work becomes trustworthy
                and worth doing.
            </p>
            <p>
                I'd be glad to talk more if this feels useful. My email is
                gshreyas@icloud.com
            </p>

            <div
                class="flex flex-col gap-8 pt-2 text-base md:flex-row md:items-center md:justify-between"
            >
                <div class="flex items-center gap-5">
                    {
                        socialLinks.map((link) => (
                            <a
                                href={link.href}
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label={link.label}
                                class="text-primary/70 transition-colors hover:text-primary"
                            >
                                <svg
                                    class="size-5"
                                    viewBox="0 0 24 24"
                                    fill="currentColor"
                                    aria-hidden="true"
                                >
                                    <path d={link.path} />
                                </svg>
                            </a>
                        ))
                    }
                    <a
                        href="https://www.instagram.com/wutamelonshrey/"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Instagram"
                        class="text-primary/70 transition-colors hover:text-primary"
                    >
                        <svg
                            class="size-5"
                            viewBox="4 4 24 24"
                            fill="currentColor"
                            aria-hidden="true"
                        >
                            <path
                                d="M22.3,8.4c-0.8,0-1.4,0.6-1.4,1.4c0,0.8,0.6,1.4,1.4,1.4c0.8,0,1.4-0.6,1.4-1.4C23.7,9,23.1,8.4,22.3,8.4z"
                            ></path>
                            <path
                                d="M16,10.2c-3.3,0-5.9,2.7-5.9,5.9s2.7,5.9,5.9,5.9s5.9-2.7,5.9-5.9S19.3,10.2,16,10.2z M16,19.9c-2.1,0-3.8-1.7-3.8-3.8c0-2.1,1.7-3.8,3.8-3.8c2.1,0,3.8,1.7,3.8,3.8C19.8,18.2,18.1,19.9,16,19.9z"
                            ></path>
                            <path
                                d="M20.8,4h-9.5C7.2,4,4,7.2,4,11.2v9.5c0,4,3.2,7.2,7.2,7.2h9.5c4,0,7.2-3.2,7.2-7.2v-9.5C28,7.2,24.8,4,20.8,4z M25.7,20.8c0,2.7-2.2,5-5,5h-9.5c-2.7,0-5-2.2-5-5v-9.5c0-2.7,2.2-5,5-5h9.5c2.7,0,5,2.2,5,5V20.8z"
                            ></path>
                        </svg>
                    </a>
                </div>

                <nav
                    class="flex items-center gap-6 font-sans text-lg font-medium text-primary"
                >
                    <a
                        href={resumeUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class={pitchLinkClass}
                    >
                        Resume
                    </a>
                    <a href="/" class={pitchLinkClass}>Portfolio</a>
                </nav>
            </div>
        </footer>
    </article>
</Document>
