---
import { Image } from "astro:assets";
import researchCall from "@/assets/reachouts/9D060CEB-22DF-49D9-9E78-23CBD5AAC7BA_1_102_o.jpeg";
import resumeUrl from "@/assets/reachouts/001-shreyas-gupta.pdf?url";
import fieldworkPlates from "@/assets/reachouts/F9524E03-36D4-4238-B801-5B493ECC50A5_1_102_o 1.png";
import researchInterface from "@/assets/reachouts/Group 483327.png";
import fieldworkClassroom from "@/assets/reachouts/Group 483328.png";
import PhotoFrameWidget from "@/components/widgets/PhotoFrameWidget";
import Document from "@/layouts/Document.astro";

const pitchLinkClass =
	"font-semibold underline decoration-2 decoration-dotted underline-offset-4 transition-opacity hover:opacity-75";

const fieldworkImages = [
	{
		src: fieldworkClassroom,
		alt: "Fieldwork session with students using laptops in a classroom",
		class: "w-48 md:w-56",
	},
	{
		src: fieldworkPlates,
		alt: "Participants sorting research cards around plates on a table",
		class: "w-48 md:w-56",
	},
	{
		src: researchCall,
		alt: "Remote research interview with four participants on a video call",
		class: "w-80 md:w-[28rem]",
	},
	{
		src: researchInterface,
		alt: "Remote field study with Shreyas and a participant on a video call",
		class: "w-80 md:w-[28rem]",
	},
];

const quotes = [
	{
		name: "Varun Banka",
		role: "Founder, Atlan",
		initials: "VB",
		photo: "/noon/varun.webp",
		quote: "Love how you do your demos, I'm going to steal how you start them. Love the 120%.",
		linkedin: "https://www.linkedin.com/in/varunbanka/",
	},
	{
		name: "Suyash Agarwal",
		role: "Product Designer, Wayground",
		initials: "SA",
		photo: "/noon/suyash.jpeg",
		quote:
			"You had this way of cutting through the noise in design reviews. While everyone else would go off on tangents, you'd bring it back to the core by asking simple but sharp questions. It forced everyone to pause and actually think about the decisions we were making.",
		linkedin: "https://www.linkedin.com/in/suyashagarwal01/",
	},
	{
		name: "Chinmay Joshi",
		role: "Engineering Manager, Wayground",
		initials: "CJ",
		photo: "/noon/chinmay.jpeg",
		quote: "Shreyas, what are you buddy? Designer, presenter, developer, PM, more like everything!",
		linkedin: "https://www.linkedin.com/in/chinmayjoshi94/",
	},
];

const socialLinks = [
	{
		label: "GitHub",
		href: "https://github.com/GLaDO8",
		path: "M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12Z",
	},
	{
		label: "LinkedIn",
		href: "https://www.linkedin.com/in/shreyas-gupta/",
		path: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.063 2.063 0 0 1-2.064-2.065 2.063 2.063 0 0 1 2.064-2.064 2.064 2.064 0 0 1 0 4.129zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.728v20.543C0 23.226.792 24 1.771 24h20.451C23.2 24 24 23.226 24 22.271V1.728C24 .774 23.2 0 22.225 0z",
	},
	{
		label: "X",
		href: "https://x.com/wutamelonshrey",
		path: "M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z",
	},
];
---

<Document
	title="Karya - Shreyas Gupta"
	description="A short pitch to Karya from Shreyas Gupta."
	bodyClass="bg-beige"
	mainClass="bg-beige px-4 py-12 md:py-20"
	showNavigation={false}
	showFooter={false}
>
	<article class="mx-auto flex w-full max-w-5xl flex-col gap-14 overflow-hidden">
		<header class="mx-auto flex w-full max-w-5xl flex-col items-start gap-8 md:px-48">
			<div class="ml-1 md:ml-0">
				<PhotoFrameWidget client:visible />
			</div>
			<div class="pt-5">
				<h1
					class="text-pretty font-sans text-3xl leading-tight font-bold tracking-[-0.02em] text-primary md:text-4xl"
				>
					Why this role caught my eye
				</h1>
				<p class="mt-4 font-sans text-lg font-semibold text-secondary md:text-xl">
					A quick peek into who I am for the Karya team
				</p>
			</div>
		</header>

		<div
			class="mx-auto w-full max-w-5xl text-pretty font-sans text-lg leading-[1.7] font-medium tracking-[-0.02em] text-primary md:px-48 md:text-2xl"
		>
			<p>
				I'm Shreyas, a product & design engineer with a background in HCI,
				fieldwork, data and enterprise systems. Karya's lead product designer
				role felt shockingly well aligned with the kind of work I indulge in, so
				I put together this page for the team to get an idea of what I do and how
				I work.
			</p>

			<p class="mt-12">
				I work with a simple philosophy - you can learn anything in due time,
				and operate as a high-functioning generalist, who happens to be great at
				systems and design.
			</p>

			<section class="mt-14">
				<h2 class="text-2xl leading-tight font-bold tracking-[-0.02em] md:text-3xl">
					Research and Fieldwork
				</h2>
				<p class="mt-12">
					Research is at the heart. Gravitated by the itch to understand the
					effects of screen time, I worked with the HCI lab at the University of
					Gothenburg doing fieldwork to understand technology use in families,
					and built methodologies for researchers to study this without physical
					intervention.
				</p>
			</section>
		</div>

		<section
			aria-label="Research and fieldwork images"
			class="-mx-4 overflow-x-auto px-4 pb-2 md:-mx-8 md:px-8"
		>
			<div class="flex w-max items-center gap-12 py-2">
				{
					fieldworkImages.map((image) => (
						<figure class={`${image.class} shrink-0 bg-white p-2 shadow-[0_4px_16px_rgba(42,35,29,0.16)]`}>
							<Image
								src={image.src}
								alt={image.alt}
								loading="eager"
								decoding="async"
								class="h-auto w-full object-cover"
							/>
						</figure>
					))
				}
			</div>
		</section>

		<div
			class="mx-auto w-full max-w-5xl text-pretty font-sans text-lg leading-[1.7] font-medium tracking-[-0.02em] text-primary md:px-48 md:text-2xl"
		>
			<section>
				<h2 class="text-2xl leading-tight font-bold tracking-[-0.02em] md:text-3xl">
					AI that supports human intent
				</h2>
				<p class="mt-12">
					Gravitated by the itch to understand the effects of screen time, I
					worked with the HCI lab at the University of Gothenburg doing
					fieldwork to understand technology use in families, and built
					methodologies for researchers to study this without physical
					intervention.
				</p>
			</section>

			<section class="mt-14">
				<h2 class="text-2xl leading-tight font-bold tracking-[-0.02em] md:text-3xl">
					My operating system
				</h2>
				<p class="mt-12">
					Gravitated by the itch to understand the effects of screen time, I
					worked with the HCI lab at the University of Gothenburg doing
					fieldwork to understand technology use in families, and built
					methodologies for researchers to study this without physical
					intervention.
				</p>
			</section>
		</div>

		<section aria-label="Peer testimonials" class="-mx-4 overflow-x-auto px-4 pb-3">
			<div class="flex w-max items-start gap-12 py-2">
				{
					quotes.map((person) => (
						<figure class="relative flex w-[21rem] shrink-0 flex-col justify-between gap-8 rounded-sm border border-black/8 bg-white p-5 shadow-xs md:w-[25rem]">
							<blockquote class="text-pretty font-sans text-base leading-[1.65] font-medium text-primary md:text-lg">
								"{person.quote}"
							</blockquote>

							<figcaption class="flex items-center gap-3 pr-8">
								<div class="relative size-10 shrink-0">
									<div class="flex size-10 items-center justify-center rounded-full border border-black/8 bg-[#faffff] font-sans text-sm font-bold text-primary">
										{person.initials}
									</div>
									<img
										src={person.photo}
										alt=""
										loading="lazy"
										decoding="async"
										onerror="this.remove()"
										class="absolute inset-0 size-10 rounded-full border border-black/8 object-cover"
									/>
								</div>
								<div class="min-w-0">
									<p class="font-sans text-sm font-bold leading-tight text-primary md:text-base">
										{person.name}
									</p>
									<p class="font-sans text-sm leading-snug text-secondary md:text-base">
										{person.role}
									</p>
								</div>
							</figcaption>

							<a
								href={person.linkedin}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={`${person.name} on LinkedIn`}
								class="absolute right-5 bottom-5 inline-flex size-8 items-center justify-center rounded-full text-primary/70 transition-colors hover:text-primary"
							>
								<svg viewBox="0 0 24 24" fill="currentColor" class="size-4" aria-hidden="true">
									<path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.61 0 4.28 2.38 4.28 5.47v6.27h-.02ZM5.32 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12Zm1.78 13.02H3.54V9H7.1v11.45ZM22.23 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.72V1.72C24 .77 23.21 0 22.23 0Z" />
								</svg>
							</a>
						</figure>
					))
				}
			</div>
		</section>

		<footer
			class="mx-auto flex w-full max-w-5xl flex-col gap-12 text-pretty font-sans text-lg leading-[1.7] font-medium tracking-[-0.02em] text-primary md:px-48 md:text-2xl"
		>
			<p>
				Reading the time article reminded me of the thesis behind Snowpiercer -
				"The engine of society is eternal and we must occupy our preordained
				positions". Karya is refusing this premise and I write this from my heart
				to be a part of this team.
			</p>
			<p>Would love to talk more about the role!</p>

			<div class="flex flex-col gap-8 pt-2 text-base md:flex-row md:items-center md:justify-between">
				<div class="flex items-center gap-5">
					{
						socialLinks.map((link) => (
							<a
								href={link.href}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={link.label}
								class="text-primary/70 transition-colors hover:text-primary"
							>
								<svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
									<path d={link.path} />
								</svg>
							</a>
						))
					}
					<a
						href="https://www.instagram.com/wutamelonshrey/"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Instagram"
						class="text-primary/70 transition-colors hover:text-primary"
					>
						<svg class="size-5" viewBox="4 4 24 24" fill="currentColor" aria-hidden="true">
							<path d="M22.3,8.4c-0.8,0-1.4,0.6-1.4,1.4c0,0.8,0.6,1.4,1.4,1.4c0.8,0,1.4-0.6,1.4-1.4C23.7,9,23.1,8.4,22.3,8.4z" />
							<path d="M16,10.2c-3.3,0-5.9,2.7-5.9,5.9s2.7,5.9,5.9,5.9s5.9-2.7,5.9-5.9S19.3,10.2,16,10.2z M16,19.9c-2.1,0-3.8-1.7-3.8-3.8c0-2.1,1.7-3.8,3.8-3.8c2.1,0,3.8,1.7,3.8,3.8C19.8,18.2,18.1,19.9,16,19.9z" />
							<path d="M20.8,4h-9.5C7.2,4,4,7.2,4,11.2v9.5c0,4,3.2,7.2,7.2,7.2h9.5c4,0,7.2-3.2,7.2-7.2v-9.5C28,7.2,24.8,4,20.8,4z M25.7,20.8c0,2.7-2.2,5-5,5h-9.5c-2.7,0-5-2.2-5-5v-9.5c0-2.7,2.2-5,5-5h9.5c2.7,0,5,2.2,5,5V20.8z" />
						</svg>
					</a>
				</div>

				<nav class="flex items-center gap-6 font-sans text-base font-semibold text-secondary">
					<a href={resumeUrl} target="_blank" rel="noopener noreferrer" class={pitchLinkClass}>
						Resume
					</a>
					<a href="/" class={pitchLinkClass}>Portfolio</a>
				</nav>
			</div>
		</footer>
	</article>
</Document>
