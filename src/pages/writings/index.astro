---
import { getCollection } from "astro:content";
import Page from "@/layouts/Page.astro";

const writings = (await getCollection("notes", ({ data }) => !data.draft)).sort(
	(a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	name: "Writings",
	description: "A collection of writing by Shreyas Gupta.",
	url: "https://shrey.fyi/writings",
};
---

<Page
    title="Writings — Shreyas Gupta"
    description="Essays, observations, and writings by Shreyas Gupta."
    bodyClass="bg-beige"
    class="bg-beige"
    seo={{ jsonLd }}
>
    <section
        class="col-span-full md:col-span-8 md:col-start-3 lg:col-span-8 lg:col-start-5"
    >
		<header class="mb-10">
			<h1
				class="font-sans font-semibold text-3xl leading-[1.1] tracking-[-0.03em] text-primary text-balance md:text-4xl"
			>
				Writings
			</h1>
		</header>

		<div class="flex flex-col gap-5">
			{
				writings.map((writing) => (
					<article class="last:pb-0 flex flex-col">
						<a href={`/writings/${writing.id}`} class="group block no-underline">
							<h3 class="font-sans text-lg leading-[1.15] font-medium tracking-[-0.03em] text-primary hover:opacity-80 md:text-xl">
								{writing.data.title}
							</h3>
						</a>
                        <p class="font-sans text-sm leading-relaxed text-secondary">
                            {writing.data.date.toLocaleDateString("en-US", {
                                year: "numeric",
                                month: "short",
                                day: "numeric",
                                timeZone: "UTC",
                            })}
                        </p>
                    </article>
                ))
            }
        </div>
    </section>
</Page>
