---
import { getCollection, render } from "astro:content";
import ArticleProse from "@/components/mdoc/ArticleProse.astro";
import Page from "@/layouts/Page.astro";
import { hasCodeFence } from "@/lib/markdocContent";

export async function getStaticPaths() {
	const writings = await getCollection("notes", ({ data }) => !data.draft);
	return writings.map((writing) => ({
		params: { slug: writing.id },
		props: { writing },
	}));
}

const { writing } = Astro.props;
const { Content } = await render(writing);
const publishedDate = writing.data.date.toISOString();
const publishedDay = publishedDate.slice(0, 10);
const readableDate = writing.data.date.toLocaleDateString("en-US", {
	year: "numeric",
	month: "long",
	day: "numeric",
	timeZone: "UTC",
});

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "Article",
	headline: writing.data.title,
	description: writing.data.description,
	datePublished: publishedDate,
	author: {
		"@type": "Person",
		"@id": "https://shrey.fyi/#person",
		name: "Shreyas Gupta",
	},
	publisher: {
		"@type": "Person",
		"@id": "https://shrey.fyi/#person",
		name: "Shreyas Gupta",
	},
	url: `https://shrey.fyi/writings/${writing.id}`,
};
---

<Page
    title={`${writing.data.title} — Shreyas Gupta`}
    description={writing.data.description}
    bodyClass="bg-white"
    class="bg-white"
    navBlurBackground="white"
    preloadCodeFont={hasCodeFence(writing.body)}
    seo={{
        ogType: "article",
        article: {
            publishedTime: publishedDate,
        },
        jsonLd,
    }}
>
    <time
        datetime={publishedDay}
        class="font-sans col-span-full md:col-span-10 md:col-start-2 lg:col-span-12 lg:col-start-3 text-center text-secondary pt-12"
    >
        {readableDate}
    </time>
    <h1
        class="col-span-full md:col-span-10 md:col-start-2 lg:col-span-12 lg:col-start-3 font-sans font-bold text-4xl leading-[1.15] tracking-[-0.02em] text-primary mb-16 text-center text-balance md:text-5xl md:leading-[1.1] lg:text-6xl"
    >
        {writing.data.title}
    </h1>

    <article
        class="col-span-full md:col-span-8 md:col-start-3 lg:col-span-8 lg:col-start-5"
    >
        <ArticleProse>
            <Content />
        </ArticleProse>
    </article>
</Page>
