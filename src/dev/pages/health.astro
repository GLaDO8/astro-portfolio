---
import HealthDashboard from "@/components/health/HealthDashboard";
import Page from "@/layouts/Page.astro";
---

<Page
    title="Health dashboard — local development"
    description="A private local dashboard for selected Apple Health and medical-report metrics."
    bodyClass="bg-beige"
    class="bg-beige gap-y-10"
    preloadCodeFont
    seo={{ noindex: true }}
>
    <div class="col-span-full md:col-span-10 md:col-start-2 lg:col-span-12 lg:col-start-3">
        <HealthDashboard client:load />
    </div>
</Page>
