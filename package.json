{
	"name": "shreyas-site",
	"type": "module",
	"version": "1.3.0",
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"dev": "astro dev",
		"build": "pnpm images && astro build",
		"build:astro": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"test": "node --test tests/**/*.test.mjs",
		"verify:changed": "node scripts/verify-changed.mjs",
		"verify:content": "node scripts/verify-content.mjs",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"check": "biome check .",
		"check:design": "node scripts/check-design-tokens.mjs",
		"images": "node scripts/optimize-images.mjs",
		"images:watch": "node scripts/optimize-images.mjs --watch",
		"health:dev": "wrangler dev --config workers/health-ingest/wrangler.jsonc",
		"health:types": "wrangler types workers/health-ingest/worker-configuration.d.ts --config workers/health-ingest/wrangler.jsonc",
		"health:types:check": "wrangler types workers/health-ingest/worker-configuration.d.ts --config workers/health-ingest/wrangler.jsonc --check",
		"health:typecheck": "tsc --project workers/health-ingest/tsconfig.json --noEmit",
		"health:deploy:dry": "wrangler deploy --config workers/health-ingest/wrangler.jsonc --dry-run",
		"health:verify": "pnpm health:types:check && pnpm health:typecheck && pnpm health:deploy:dry",
		"health:deploy": "wrangler deploy --config workers/health-ingest/wrangler.jsonc",
		"health:secret:set": "wrangler secret put HEALTH_INGEST_TOKEN --config workers/health-ingest/wrangler.jsonc",
		"health:db:migrate:local": "wrangler d1 migrations apply health-processed-data --config workers/health-ingest/wrangler.jsonc --local",
		"health:db:migrate:remote": "wrangler d1 migrations apply health-processed-data --config workers/health-ingest/wrangler.jsonc --remote"
	},
	"dependencies": {
		"@astrojs/markdoc": "^2.0.6",
		"@astrojs/react": "^6.0.2",
		"@astrojs/sitemap": "^3.7.3",
		"@google/model-viewer": "^4.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"@web-kits/audio": "^0.1.0",
		"agentation": "^3.0.2",
		"astro": "^7.2.0",
		"clsx": "^2.1.1",
		"d3": "^7.9.0",
		"lenis": "^1.3.26",
		"lottie-web": "^5.13.0",
		"mesurer": "^0.0.9",
		"motion": "^13.0.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"smol-toml": "^1.7.1",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"three": "^0.183.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@markdoc/markdoc": "0.5.9",
		"@types/d3": "^7.4.3",
		"@types/node": "^26.1.2",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"sharp": "^0.35.3",
		"typescript": "^5.9.3",
		"vite": "8.2.0",
		"wrangler": "^4.119.0"
	}
}
